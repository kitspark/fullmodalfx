{
  "name": "@kitspark/fullmodalfx",
  "version": "1.2.0",
  "description": "Lightweight, dependency-free fullscreen modal library with animated transitions.",
  "license": "MIT",
  "author": "Kitspark",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitspark/fullmodalfx"
  },
  "homepage": "https://github.com/kitspark/fullmodalfx#readme",
  "bugs": {
    "url": "https://github.com/kitspark/fullmodalfx/issues"
  },
  "keywords": [
    "modal",
    "fullscreen",
    "typescript",
    "ui",
    "overlay",
    "lightweight"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && cp styles/fullmodalfx.css dist/styles.css",
    "prepublishOnly": "pnpm build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "jsdom": "^28.1.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
